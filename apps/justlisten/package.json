{
  "name": "justlisten",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vike dev",
    "build": "vike build",
    "preview": "vike preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "secrets:push": "secreq run --env-file .env.production -- node tools/secrets.mjs",
    "secrets:init": "secreq run --env-file .env.production --prompt-unresolved -- node tools/secrets.mjs"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "typecheck"
        ]
      },
      "deploy": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node tools/deploy.mjs",
          "cwd": "{projectRoot}"
        },
        "configurations": {
          "preview": {
            "command": "node tools/deploy.mjs --preview"
          }
        }
      }
    }
  },
  "dependencies": {
    "@new-personal-monorepo/small-app-design-system": "workspace:*",
    "@universal-middleware/core": "^0.4.17",
    "@vikejs/hono": "^0.2.0",
    "hono": "^4.13.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "vike": "catalog:",
    "vike-react": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^4.0.9",
    "wrangler": "^4.124.0"
  }
}
