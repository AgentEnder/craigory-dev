# JustListen — provider credentials contract.
#
# This file holds 1Password *references*, never values. `secreq run` resolves
# every `secret://op/...` entry through the consent daemon and injects the real
# value into the command's environment (see tools/secrets.mjs).
#
# One-time setup:
#   cp .env.example .env.production     # gitignored working copy
#   pnpm --filter justlisten secrets:push
#
# All four are OPTIONAL — JustListen falls back to the keyless catalogs (Deezer,
# iTunes, Bandcamp) and to per-provider search links when a credential is
# missing. Leave an entry unset in 1Password to deliberately run without that
# provider.

SPOTIFY_CLIENT_ID="secret://op/Dev Secrets/justlisten-production/SPOTIFY_CLIENT_ID"
SPOTIFY_CLIENT_SECRET="secret://op/Dev Secrets/justlisten-production/SPOTIFY_CLIENT_SECRET"
YOUTUBE_API_KEY="secret://op/Dev Secrets/justlisten-production/YOUTUBE_API_KEY"
# Free to create at https://www.last.fm/api/account/create — Last.fm has no
# keyless endpoint, so without this it degrades to search links.
LASTFM_API_KEY="secret://op/Dev Secrets/justlisten-production/LASTFM_API_KEY"

# Not a provider credential: enables GET /api/song/:provider/:id/trace, which
# reports why each provider link came out the way it did. Any random string.
# Leave unset and the endpoint 404s — it bypasses the song cache, so it is an
# uncached fan-out across every upstream and must not be open to the world.
TRACE_TOKEN="secret://op/Dev Secrets/justlisten-production/TRACE_TOKEN"
