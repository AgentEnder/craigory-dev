# JustListen — provider credentials contract.
#
# This file holds 1Password *references*, never values. `secreq run` resolves
# every `secret://op/...` entry through the consent daemon and injects the real
# value into the command's environment (see tools/secrets.mjs).
#
# One-time setup:
#   cp .env.example .env.production     # gitignored working copy
#   pnpm --filter justlisten secrets:push
#
# All three are OPTIONAL — JustListen falls back to the keyless iTunes API and
# to per-provider search links when a credential is missing. Leave an entry
# unset in 1Password to deliberately run without that provider.

SPOTIFY_CLIENT_ID="secret://op/Dev Secrets/justlisten-production/SPOTIFY_CLIENT_ID"
SPOTIFY_CLIENT_SECRET="secret://op/Dev Secrets/justlisten-production/SPOTIFY_CLIENT_SECRET"
YOUTUBE_API_KEY="secret://op/Dev Secrets/justlisten-production/YOUTUBE_API_KEY"
